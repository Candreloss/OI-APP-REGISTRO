<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Participantes y Pagos | Organización Inteligente</title>
    <link rel="icon" type="image/png" href="/img/favicon.ico">
    
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&display=swap" rel="stylesheet">
    <script src="https://code.iconify.design/iconify-icon/1.0.7/iconify-icon.min.js"></script>
    <link rel="stylesheet" href="/css/tailwind.css">
    <link rel="stylesheet" href="/css/adminpanel.css">
</head>
<body>
    <div class="dashboard-container">
        
        <aside class="sidebar">
            <div class="sidebar-header">
                <img src="/img/pic01.png" alt="Logo OI" class="sidebar-logo">
            </div>
            <nav class="sidebar-nav">
                <a href="/panel" class="nav-item">
                    <iconify-icon icon="lucide:layout-dashboard"></iconify-icon>
                    <span>Dashboard</span>
                </a>
                <a href="/panel/ofertas" class="nav-item">
                    <iconify-icon icon="lucide:book-open"></iconify-icon>
                    <span>Ofertas de Capacitación</span>
                </a>
                <a href="/panel/participantes" class="nav-item active">
                    <iconify-icon icon="lucide:users"></iconify-icon>
                    <span>Participantes y Pagos</span>
                </a>
                <a href="/panel/empresas" class="nav-item">
                    <iconify-icon icon="lucide:building-2"></iconify-icon>
                    <span>Empresas B2B</span>
                </a>
            </nav>
            <div class="sidebar-footer">
                <a href="/logout" class="nav-item logout-btn" onclick="cerrarSesion(event)">
                    <iconify-icon icon="lucide:log-out"></iconify-icon>
                    <span>Cerrar Sesión</span>
                </a>
            </div>
        </aside>

        <main class="main-content">
            <header class="top-header">
                <div class="header-title">
                    <h1>Módulo de Conciliación</h1>
                </div>
                <div class="header-user">
                    <iconify-icon icon="lucide:user-circle" class="user-icon"></iconify-icon>
                    <span class="user-name">Hola, Admin</span>
                </div>
            </header>

            <div class="bg-white rounded-xl shadow-sm border border-gray-100 p-6 mt-8">
              
              <div class="flex justify-between items-center mb-6">
                <div>
                  <h2 class="text-2xl font-bold text-gray-800">Gestión de Participantes</h2>
                  <p class="text-gray-500 text-sm"><%= total %> inscripci<%= total === 1 ? 'ón' : 'ones' %> encontrada<%= total === 1 ? '' : 's' %>.</p>
                </div>
              </div>

              <% /* ---- Barra de filtros ---- */ %>
              <form method="GET" action="/panel/participantes" id="form-filtros" class="mb-6 space-y-3">
                <div class="flex flex-wrap gap-3 items-center">
                  <div class="relative">
                    <select name="estado" onchange="this.form.submit()" class="border border-gray-300 rounded-lg px-4 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-blue-500">
                        <option value="">Todos los estados</option>
                        <option value="pendiente" <%= filtros.estado === 'pendiente' ? 'selected' : '' %>>Pendiente</option>
                        <option value="en_revision" <%= filtros.estado === 'en_revision' ? 'selected' : '' %>>En Revisión</option>
                        <option value="conciliado" <%= filtros.estado === 'conciliado' ? 'selected' : '' %>>Conciliado</option>
                        <option value="rechazado" <%= filtros.estado === 'rechazado' ? 'selected' : '' %>>Rechazado</option>
                    </select>
                  </div>
                  <div class="relative">
                    <select name="empresa" onchange="this.form.submit()" class="border border-gray-300 rounded-lg px-4 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-blue-500">
                        <option value="">Todas las Empresas</option>
                        <option value="SIN_EMPRESA" <%= filtros.empresa === 'SIN_EMPRESA' ? 'selected' : '' %>>Individuales</option>
                        <% (opciones.empresas || []).forEach(emp => { %>
                            <option value="<%= emp %>" <%= filtros.empresa === emp ? 'selected' : '' %>><%= emp %></option>
                        <% }); %>
                    </select>
                  </div>
                  <div class="relative">
                    <select name="capacitacion" onchange="this.form.submit()" class="border border-gray-300 rounded-lg px-4 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-blue-500">
                        <option value="">Todas las Capacitaciones</option>
                        <% (opciones.capacitaciones || []).forEach(cap => { %>
                            <option value="<%= cap %>" <%= filtros.capacitacion === cap ? 'selected' : '' %>><%= cap %></option>
                        <% }); %>
                    </select>
                  </div>
                  <div class="relative flex-1 min-w-[200px]">
                    <input type="text" name="q" value="<%= filtros.busqueda || '' %>" placeholder="Buscar por cédula o nombre..."
                           class="w-full border border-gray-300 rounded-lg px-4 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-blue-500">
                  </div>
                  <button type="submit" class="px-4 py-2 text-sm font-medium text-white bg-blue-600 rounded-lg hover:bg-blue-700">
                    Buscar
                  </button>
                  <a href="/panel/participantes" class="px-4 py-2 text-sm font-medium text-gray-600 bg-gray-100 rounded-lg hover:bg-gray-200">
                    Limpiar
                  </a>
                </div>
              </form>
              
              <div class="overflow-x-auto">
                <table class="w-full text-left border-collapse">
                  <thead>
                    <tr class="bg-gray-50 text-gray-600 text-sm border-b border-gray-200">
                      <th class="p-4 font-semibold">Documento</th>
                      <th class="p-4 font-semibold">Participante</th>
                      <th class="p-4 font-semibold">Capacitación</th>
                      <th class="p-4 font-semibold">Estado</th>
                      <th class="p-4 font-semibold text-center">Acciones</th>
                    </tr>
                  </thead>
                  <tbody id="tabla-inscripciones" class="text-sm text-gray-700 divide-y divide-gray-100">
                    
                    <% if (inscripciones && inscripciones.length > 0) { %>
                        <% inscripciones.forEach((ins) => { %>
                            
                            <tr class="hover:bg-gray-50 transition-colors tabla-fila-participante">
                              
                              <td class="p-4 font-mono"><%= ins.perdoc %></td>
                              <td class="p-4">
                                <div class="font-medium text-gray-900"><%= ins.pernombre %> <%= ins.perapellido %></div>
                                <div class="text-xs text-gray-500"><%= ins.pertelefono %></div>
                                
                                <% if (ins.empresa_nombre) { %>
                                    <div class="mt-1 inline-flex items-center gap-1 px-2 py-0.5 rounded text-xs font-medium bg-blue-50 text-blue-700 border border-blue-100">
                                        <iconify-icon icon="lucide:building-2"></iconify-icon> <%= ins.empresa_nombre %>
                                    </div>
                                <% } %>
                              </td>
                              <td class="p-4"><%= ins.capnombre %></td>
                              <td class="p-4">
                                <% if(ins.ins_estado === 'pendiente') { %>
                                    <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium bg-yellow-100 text-yellow-800">Pendiente</span>
                                <% } else if(ins.ins_estado === 'en_revision') { %>
                                    <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium bg-orange-100 text-orange-800">En Revisión</span>
                                <% } else if(ins.ins_estado === 'conciliado') { %>
                                    <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium bg-green-100 text-green-800">Conciliado</span>
                                <% } else { %>
                                    <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium bg-red-100 text-red-800">Rechazado</span>
                                <% } %>
                              </td>
                              <td class="p-4 flex justify-center gap-2">
                                <button type="button" class="btn-editar p-2 text-blue-600 hover:bg-blue-50 rounded-lg"
                                        data-doc="<%= ins.perdoc %>"
                                        data-nombre="<%= ins.pernombre %>"
                                        data-apellido="<%= ins.perapellido %>"
                                        data-telefono="<%= ins.pertelefono || '' %>" title="Editar Perfil">
                                  <iconify-icon icon="lucide:edit" class="text-lg"></iconify-icon>
                                </button>

                                <% if(ins.ins_estado === 'en_revision') { %>
                                    <button type="button" class="btn-pago p-2 text-orange-600 hover:bg-orange-50 rounded-lg"
                                            data-inscodigo="<%= ins.inscodigo %>"
                                            data-titular="<%= [ins.titular_nombre, ins.titular_apellido].filter(Boolean).join(' ') %>"
                                            data-banco="<%= ins.banco_origen || '' %>"
                                            data-referencia="<%= ins.referencia || '' %>"
                                            data-telefono="<%= ins.tlf_pago || '' %>"
                                            data-fecha="<%= ins.fecha_pago || '' %>" title="Revisar Pago">
                                      <iconify-icon icon="lucide:dollar-sign" class="text-lg"></iconify-icon>
                                    </button>
                                <% } %>

                                <button type="button" class="btn-eliminar p-2 text-red-600 hover:bg-red-50 rounded-lg"
                                        data-inscodigo="<%= ins.inscodigo %>"
                                        data-nombre="<%= [ins.pernombre, ins.perapellido].filter(Boolean).join(' ') %>" title="Eliminar Cupo">
                                    <iconify-icon icon="lucide:trash-2" class="text-lg"></iconify-icon>
                                </button>
                              </td>
                            </tr>

                        <% }); %>
                    <% } else { %>
                        <tr>
                            <td colspan="5" class="p-8 text-center text-gray-500">No se encontraron participantes con esos filtros.</td>
                        </tr>
                    <% } %>

                  </tbody>
                </table>
              </div>

              <% /* ---- Paginación ---- */ %>
              <% if (totalPaginas > 1) { %>
              <div class="flex justify-center items-center gap-2 mt-6 pt-4 border-t border-gray-100">
                <% 
                  // Construir query string base sin pagina
                  const baseParams = [];
                  if (filtros.estado) baseParams.push('estado=' + encodeURIComponent(filtros.estado));
                  if (filtros.empresa) baseParams.push('empresa=' + encodeURIComponent(filtros.empresa));
                  if (filtros.capacitacion) baseParams.push('capacitacion=' + encodeURIComponent(filtros.capacitacion));
                  if (filtros.busqueda) baseParams.push('q=' + encodeURIComponent(filtros.busqueda));
                  const baseQs = baseParams.length ? '&' + baseParams.join('&') : '';

                  const paginas = [];
                  const delta = 2;
                  for (let i = Math.max(1, pagina - delta); i <= Math.min(totalPaginas, pagina + delta); i++) {
                      paginas.push(i);
                  }
                %>

                <% if (pagina > 1) { %>
                  <a href="?pagina=<%= pagina - 1 %><%= baseQs %>" class="px-3 py-2 text-sm font-medium text-gray-600 bg-gray-100 rounded-lg hover:bg-gray-200">&laquo; Anterior</a>
                <% } %>

                <% if (paginas[0] > 1) { %>
                  <a href="?pagina=1<%= baseQs %>" class="px-3 py-2 text-sm font-medium text-gray-600 bg-white border border-gray-200 rounded-lg hover:bg-gray-50">1</a>
                  <% if (paginas[0] > 2) { %><span class="text-gray-400 px-1">...</span><% } %>
                <% } %>

                <% paginas.forEach(p => { %>
                  <a href="?pagina=<%= p %><%= baseQs %>"
                     class="px-3 py-2 text-sm font-medium rounded-lg <%= p === pagina ? 'bg-blue-600 text-white' : 'text-gray-600 bg-white border border-gray-200 hover:bg-gray-50' %>">
                    <%= p %>
                  </a>
                <% }); %>

                <% if (paginas[paginas.length - 1] < totalPaginas) { %>
                  <% if (paginas[paginas.length - 1] < totalPaginas - 1) { %><span class="text-gray-400 px-1">...</span><% } %>
                  <a href="?pagina=<%= totalPaginas %><%= baseQs %>" class="px-3 py-2 text-sm font-medium text-gray-600 bg-white border border-gray-200 rounded-lg hover:bg-gray-50"><%= totalPaginas %></a>
                <% } %>

                <% if (pagina < totalPaginas) { %>
                  <a href="?pagina=<%= pagina + 1 %><%= baseQs %>" class="px-3 py-2 text-sm font-medium text-gray-600 bg-gray-100 rounded-lg hover:bg-gray-200">Siguiente &raquo;</a>
                <% } %>
              </div>
              <% } %>

            </div>
        </main>
    </div>

    <div id="modal-edicion" class="fixed inset-0 bg-gray-900 bg-opacity-50 hidden flex items-center justify-center z-50">
      <div class="bg-white rounded-xl shadow-xl w-full max-w-lg overflow-hidden">
        <div class="px-6 py-4 border-b border-gray-100 flex justify-between items-center bg-gray-50">
          <h3 class="text-lg font-bold text-gray-800">Editar Datos del Participante</h3>
          <button onclick="cerrarModal('modal-edicion')" class="text-gray-400 hover:text-gray-600"><iconify-icon icon="lucide:x" class="text-xl"></iconify-icon></button>
        </div>
        <div class="p-6">
          <form id="form-editar-usuario">
            <input type="hidden" id="edit-doc" />
            <div class="grid grid-cols-2 gap-4">
              <div>
                <label class="block text-sm font-medium text-gray-700 mb-1">Nombre</label>
                <input type="text" id="edit-nombre" class="w-full border border-gray-300 rounded-lg px-3 py-2 text-sm focus:ring-blue-500 focus:border-blue-500">
              </div>
              <div>
                <label class="block text-sm font-medium text-gray-700 mb-1">Apellido</label>
                <input type="text" id="edit-apellido" class="w-full border border-gray-300 rounded-lg px-3 py-2 text-sm focus:ring-blue-500 focus:border-blue-500">
              </div>
              <div class="col-span-2">
                <label class="block text-sm font-medium text-gray-700 mb-1">Teléfono</label>
                <input type="text" id="edit-telefono" class="w-full border border-gray-300 rounded-lg px-3 py-2 text-sm focus:ring-blue-500 focus:border-blue-500">
              </div>
            </div>
            <div class="mt-6 flex justify-end gap-3">
              <button type="button" onclick="cerrarModal('modal-edicion')" class="px-4 py-2 text-sm font-medium text-gray-700 bg-white border border-gray-300 rounded-lg hover:bg-gray-50">Cancelar</button>
              <button type="button" onclick="guardarEdicion()" class="px-4 py-2 text-sm font-medium text-white bg-blue-600 rounded-lg hover:bg-blue-700">Guardar Cambios</button>
            </div>
          </form>
        </div>
      </div>
    </div>

    <div id="modal-pago" class="fixed inset-0 bg-gray-900 bg-opacity-50 hidden flex items-center justify-center z-50">
      <div class="bg-white rounded-xl shadow-xl w-full max-w-md overflow-hidden">
        <div class="px-6 py-4 border-b border-gray-100 flex justify-between items-center bg-orange-50">
          <h3 class="text-lg font-bold text-orange-800">Revisión de Pago</h3>
          <button onclick="cerrarModal('modal-pago')" class="text-gray-400 hover:text-gray-600"><iconify-icon icon="lucide:x" class="text-xl"></iconify-icon></button>
        </div>
        <div class="p-6">
          <div class="bg-gray-50 rounded-lg p-4 mb-6 border border-gray-100">
            <p class="text-sm text-gray-500 mb-1">Titular de la cuenta</p>
            <p class="font-medium text-gray-900 mb-3" id="ver-titular"></p>
            <div class="grid grid-cols-2 gap-4 mb-3">
              <div><p class="text-sm text-gray-500 mb-1">Banco</p><p class="font-medium text-gray-900" id="ver-banco"></p></div>
              <div><p class="text-sm text-gray-500 mb-1">Referencia</p><p class="font-mono text-gray-900 font-bold tracking-wider" id="ver-referencia"></p></div>
            </div>
            <div class="grid grid-cols-2 gap-4">
              <div><p class="text-sm text-gray-500 mb-1">Teléfono Asociado</p><p class="font-medium text-gray-900" id="ver-telefono"></p></div>
              <div><p class="text-sm text-gray-500 mb-1">Fecha del Reporte</p><p class="font-medium text-gray-900" id="ver-fecha"></p></div>
            </div>
          </div>
          <div class="flex flex-col gap-3">
            <button type="button" onclick="procesarPago('aprobar')" class="w-full px-4 py-3 text-sm font-medium text-white bg-green-600 rounded-lg hover:bg-green-700 flex justify-center items-center gap-2"><iconify-icon icon="lucide:check-circle"></iconify-icon> Aprobar y Conciliar</button>
            <button type="button" onclick="procesarPago('rechazar')" class="w-full px-4 py-3 text-sm font-medium text-red-700 bg-red-50 rounded-lg hover:bg-red-100 border border-red-200 flex justify-center items-center gap-2"><iconify-icon icon="lucide:x-circle"></iconify-icon> Rechazar y Eliminar Reporte</button>
          </div>
        </div>
      </div>
    </div>

    <script src="/js/csrf.js"></script>
    <script>
      async function cerrarSesion(evento) {
        evento.preventDefault();
        try {
          await apiFetch("/logout", { method: "POST" });
        } finally {
          window.location.href = "/admin";
        }
      }
    </script>
    <script>
      let inscripcionActiva = null;

      document.getElementById('tabla-inscripciones').addEventListener('click', (evento) => {
        const btn = evento.target.closest('button');
        if (!btn) return;

        if (btn.classList.contains('btn-editar')) {
          abrirModalEdicion(btn.dataset);
        } else if (btn.classList.contains('btn-pago')) {
          abrirModalPago(btn.dataset);
        } else if (btn.classList.contains('btn-eliminar')) {
          eliminarParticipante(btn.dataset.inscodigo, btn.dataset.nombre);
        }
      });

      function abrirModalEdicion(datos) { 
        document.getElementById('edit-doc').value = datos.doc;
        document.getElementById('edit-nombre').value = datos.nombre;
        document.getElementById('edit-apellido').value = datos.apellido;
        document.getElementById('edit-telefono').value = datos.telefono;
        document.getElementById('modal-edicion').classList.remove('hidden'); 
      }
      
      function abrirModalPago(datos) { 
        document.getElementById('ver-titular').textContent = datos.titular;
        document.getElementById('ver-banco').textContent = datos.banco;
        document.getElementById('ver-referencia').textContent = datos.referencia;
        document.getElementById('ver-telefono').textContent = datos.telefono;
        document.getElementById('ver-fecha').textContent = datos.fecha;
        inscripcionActiva = datos.inscodigo; 
        document.getElementById('modal-pago').classList.remove('hidden'); 
      }
      
      function cerrarModal(id) { 
        document.getElementById(id).classList.add('hidden'); 
      }

      async function guardarEdicion() { 
        const doc = document.getElementById('edit-doc').value;
        const nombre = document.getElementById('edit-nombre').value.trim();
        const apellido = document.getElementById('edit-apellido').value.trim();
        const telefono = document.getElementById('edit-telefono').value.trim();

        if(!nombre || !apellido) {
            alert("El nombre y el apellido no pueden estar vacíos.");
            return;
        }

        try {
            const response = await apiFetch('/panel/participantes/editar', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ doc, nombre, apellido, telefono })
            });
            const data = await response.json();
            if(data.success) {
                alert("¡Perfil actualizado con éxito!");
                cerrarModal('modal-edicion');
                window.location.reload(); 
            } else {
                alert("Error: " + data.message);
            }
        } catch (error) {
            alert("Error de conexión con el servidor.");
        }
      }

      async function procesarPago(accion) { 
        if(!inscripcionActiva) return;
        let confirmacion = accion === 'aprobar' 
            ? '¿Conciliar pago y notificar al participante?' 
            : '¿Rechazar pago, eliminar reporte y notificar al participante?';

        if(confirm(confirmacion)) {
            try {
                const response = await apiFetch(`/panel/pagos/${accion}/${inscripcionActiva}`, { method: 'POST' });
                const data = await response.json();
                if(data.success) {
                    alert(data.message);
                    window.location.reload(); 
                } else {
                    alert("Error: " + data.message);
                }
            } catch (error) {
                alert("Error de conexión con el servidor.");
            }
        }
        cerrarModal('modal-pago'); 
      }

      async function eliminarParticipante(inscodigo, nombre) {
          if (!confirm(`⚠️ ¡ATENCIÓN! ⚠️\n\n¿Estás seguro de que deseas ELIMINAR la inscripción de ${nombre}?\n\nEsta acción borrará su cupo y cualquier reporte de pago asociado de forma permanente.`)) return;
          try {
              const response = await apiFetch(`/panel/participantes/eliminar/${inscodigo}`, { method: 'POST' });
              const data = await response.json();
              if (data.success) {
                  alert(data.message);
                  window.location.reload(); 
              } else {
                  alert("Error: " + data.message);
              }
          } catch (error) {
              alert("Error de red conectando con el servidor.");
          }
      }
    </script>
</body>
</html>
