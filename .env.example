# ==========================================================
# PLANTILLA DE VARIABLES DE ENTORNO - Organización Inteligente
# Copia este archivo como .env y llena los valores reales.
# NUNCA subas el .env real a Git.
# ==========================================================

# --- Configuración del Servidor ---
PORT=3000
NODE_ENV=development

# --- Base de Datos ---
DB_HOST=localhost
DB_USER=root
DB_PASS=tu_contraseña
DB_NAME=oi_cap_db_final
DB_PORT=3306

# TLS hacia la BD (recomendado en Aiven / producción)
# DB_SSL=true  -> activa TLS sin verificar CA
# DB_SSL_CA=... -> certificado CA de Aiven en una línea (\n escapados), fuerza verificación completa
DB_SSL=false

# --- Correo (Resend) ---
RESEND_API_KEY=re_tu_api_key
ADMIN_EMAIL=notificaciones@tudominio.com

# --- Seguridad de Sesiones ---
# Genera uno fuerte con: openssl rand -hex 48
SESSION_SECRET=cambia_esto_por_un_secreto_largo_y_aleatorio
